{
  "name": "uav-ble-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight UAV BLE Low-Latency Flight Controller Frontend & Mobile App (Web Bluetooth + Gamepad + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test:protocol": "node test/verify_protocol.mjs",
    "test:controller": "node test/verify_controller.mjs",
    "test": "node test/verify_protocol.mjs && node test/verify_controller.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
